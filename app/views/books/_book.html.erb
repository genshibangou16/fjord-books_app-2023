<div id="<%= dom_id book %>">
  <p>
    <strong><%= t('views.books.index.list.title') %>:</strong>
    <%= book.title %>
  </p>
  <p>
    <strong><%= t('views.books.index.list.memo') %>:</strong>
    <%= book.memo %>
  </p>
  <p>
    <strong><%= t('views.books.index.list.author') %>:</strong>
    <%= book.author %>
  </p>
  <p>
    <strong><%= t('views.books.index.list.picture') %>:</strong>
    <%= image_tag(book.picture_url) if book.picture.present? %>
  </p>
</div>
