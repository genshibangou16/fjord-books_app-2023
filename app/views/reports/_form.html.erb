<%= form_with(model: report) do |form| %>
  <%= render partial: 'common/error', locals: { errors: report.errors, model: Report } if report.errors.any? %>
  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, required: true %>
  </div>
  <div>
    <%= form.label :memo, style: "display: block" %>
    <%= form.text_area :memo %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
